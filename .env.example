# Default SSH login for stands and devices that reference `default-ssh`.
HARDWARE_TEST_CREDENTIALS__DEFAULT_SSH__USERNAME=tester
HARDWARE_TEST_CREDENTIALS__DEFAULT_SSH__PASSWORD=change-me

# SSH login for measurement equipment that references `analyzer-default`.
HARDWARE_TEST_CREDENTIALS__ANALYZER_DEFAULT__USERNAME=tester
HARDWARE_TEST_CREDENTIALS__ANALYZER_DEFAULT__PASSWORD=change-me

# SSH login for signal sources that reference `generator-default`.
HARDWARE_TEST_CREDENTIALS__GENERATOR_DEFAULT__USERNAME=tester
HARDWARE_TEST_CREDENTIALS__GENERATOR_DEFAULT__PASSWORD=change-me

# Linux serial-console logins referenced by `console_credentials` in inventory.
HARDWARE_TEST_CREDENTIALS__CONSOLE='{"dut-console":{"username":"root","password":"change-me"}}'

# Global SSH host-key verification defaults; inventory may override the policy per device.
HARDWARE_TEST_SSH_HOST_KEY_POLICY=reject
# HARDWARE_TEST_SSH_KNOWN_HOSTS_PATH=/etc/hardware-test/known_hosts
