# Copy to .env and generate a DIFFERENT value for each password: openssl rand -hex 32
# Hexadecimal passwords also work safely inside the analyzer AMQP connection URI.
REPORTPORTAL_DB_PASSWORD=
REPORTPORTAL_AMQP_PASSWORD=
REPORTPORTAL_ADMIN_PASSWORD=

# Only the gateway is published. Defaults avoid the runner (8080) and Allure (3000).
REPORTPORTAL_BIND_ADDRESS=127.0.0.1
REPORTPORTAL_PORT=8082
