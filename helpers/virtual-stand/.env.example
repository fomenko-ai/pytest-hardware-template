# Use absolute host paths. Docker bind mounts are resolved by the host daemon.
VIRTUAL_STAND_PROJECT_ROOT=/absolute/path/to/pytest-hardware-template
VIRTUAL_STAND_RUNTIME_ROOT=/absolute/path/to/pytest-hardware-template/helpers/virtual-stand/runtime

# Local emulator credential. Put the real value only in the ignored .env file.
VIRTUAL_STAND_PASSWORD=replace-with-a-local-password

# Host port for the runner UI.
TEST_RUNNER_PORT=8080
