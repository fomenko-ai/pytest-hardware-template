# Bind to loopback for local use. Put the service behind a TLS reverse proxy on a server.
ALLURE_BIND_ADDRESS=127.0.0.1
ALLURE_PORT=3000
ALLURE_MAIN_BRANCH=main

# Generate unique values and keep the real values only in the untracked .env file.
ALLURE_STORAGE_BOOTSTRAP_TOKEN=
ALLURE_STORAGE_SIGNING_SECRET=
