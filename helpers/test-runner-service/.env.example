# Host port for the runner UI and API. The container always listens on port 8080.
TEST_RUNNER_PORT=8080

# Absolute host paths used by both the runner container and the host Docker daemon.
TEST_RUNNER_FRAMEWORK_SOURCE=/opt/hardware-runner/framework
TEST_RUNNER_FRAMEWORK_DOCKERFILE=/opt/hardware-runner/framework/Dockerfile
TEST_RUNNER_INVENTORY_DIRECTORY=/opt/hardware-runner/inventory
TEST_RUNNER_INVENTORY_FILE=/opt/hardware-runner/inventory/stands.yaml
TEST_RUNNER_ARTIFACTS_DIRECTORY=/opt/hardware-runner/artifacts
TEST_RUNNER_STATE_DIRECTORY=/opt/hardware-runner/state

# Optional paths below each pytest session directory. Empty disables that runner capability.
TEST_RUNNER_PYTEST_LOG_PATH=pytest.log
TEST_RUNNER_JUNIT_PATH=reports/junit.xml
TEST_RUNNER_HTML_PATH=reports/report.html
TEST_RUNNER_ALLURE_RESULTS_PATH=allure-results

# Files passed to hardware-test containers. Keep secrets only in the untracked environment file.
TEST_RUNNER_ENV_FILE=/opt/hardware-runner/test.env
TEST_RUNNER_KNOWN_HOSTS_FILE=/opt/hardware-runner/known_hosts

# Optional Docker network used by hardware-test containers.
TEST_RUNNER_DOCKER_NETWORK=

# Comma-separated prefixes accepted for image pull and run requests.
TEST_RUNNER_ALLOWED_IMAGE_PREFIXES=sha256:

# Maximum duration of one build, pull, or test operation.
TEST_RUNNER_OPERATION_TIMEOUT_SECONDS=3600

# Authentication mode: disabled, local, or keycloak.
TEST_RUNNER_AUTH_MODE=disabled

# Browser authentication: username/password followed by a signed session cookie.
TEST_RUNNER_AUTH_USERNAME=
TEST_RUNNER_AUTH_PASSWORD=
TEST_RUNNER_AUTH_SESSION_SECRET=
TEST_RUNNER_AUTH_SESSION_TTL_SECONDS=604800
TEST_RUNNER_AUTH_COOKIE_SECURE=false

# Optional machine-to-machine Bearer authentication for CI clients.
TEST_RUNNER_AUTH_API_TOKEN=

# Keycloak OIDC settings. Required only when TEST_RUNNER_AUTH_MODE=keycloak.
TEST_RUNNER_PUBLIC_URL=
TEST_RUNNER_OIDC_ISSUER=
TEST_RUNNER_OIDC_CLIENT_ID=
TEST_RUNNER_OIDC_CLIENT_SECRET=
TEST_RUNNER_OIDC_AUDIENCE=
TEST_RUNNER_OIDC_VIEWER_ROLE=hardware-test-runner.viewer
TEST_RUNNER_OIDC_OPERATOR_ROLE=hardware-test-runner.operator
TEST_RUNNER_OIDC_JWKS_CACHE_SECONDS=3600
TEST_RUNNER_OIDC_CLOCK_SKEW_SECONDS=30

# Optional Allure 3 publication. Keep the real ars1 token only in the untracked .env file.
TEST_RUNNER_ALLURE_ENABLED=false
TEST_RUNNER_ALLURE_PUBLISHER_IMAGE=local/allure-publisher:3.17.0
TEST_RUNNER_ALLURE_ACCESS_TOKEN=
TEST_RUNNER_ALLURE_PUBLIC_URL=
TEST_RUNNER_ALLURE_REPOSITORY=pytest-hardware-template

# Optional pytest-reportportal integration. API key stays server-side.
# Endpoint must be reachable by BOTH runner and test containers; public URL is for the browser.
TEST_RUNNER_REPORTPORTAL_ENABLED=false
TEST_RUNNER_REPORTPORTAL_ENDPOINT=
TEST_RUNNER_REPORTPORTAL_PUBLIC_URL=
TEST_RUNNER_REPORTPORTAL_PROJECT=
TEST_RUNNER_REPORTPORTAL_API_KEY=
