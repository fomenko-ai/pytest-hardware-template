# Host port for the runner UI and API. The container always listens on port 8080.
TEST_RUNNER_PORT=8080

# Absolute host paths used by both the runner container and the host Docker daemon.
TEST_RUNNER_FRAMEWORK_SOURCE=/opt/hardware-runner/framework
TEST_RUNNER_FRAMEWORK_DOCKERFILE=/opt/hardware-runner/framework/Dockerfile
TEST_RUNNER_INVENTORY_DIRECTORY=/opt/hardware-runner/inventory
TEST_RUNNER_INVENTORY_FILE=/opt/hardware-runner/inventory/stands.yaml
TEST_RUNNER_ARTIFACTS_DIRECTORY=/opt/hardware-runner/artifacts
TEST_RUNNER_STATE_DIRECTORY=/opt/hardware-runner/state

# Comma-separated prefixes accepted for image pull and run requests.
TEST_RUNNER_ALLOWED_IMAGE_PREFIXES=sha256:

# Maximum duration of one build, pull, or test operation.
TEST_RUNNER_OPERATION_TIMEOUT_SECONDS=3600
